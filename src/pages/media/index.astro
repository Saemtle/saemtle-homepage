---
import BaseLayout from '../../layouts/BaseLayout.astro';

const youtubePlaylistId = 'RDimECMymNsjQ';
const firstVideoId = 'imECMymNsjQ';

const newsItems = [
  {
    source: '연합뉴스',
    title: '샘틀, 스마트 농업용 수위 측정·제어 시스템 기술력 주목',
    date: '2026.05.20',
    url: 'https://www.yna.co.kr/view/AKR20260520093700011',
    description: '연합뉴스에 보도된 샘틀 관련 기사입니다. 링크를 클릭하여 전체 기사를 확인하세요.',
  },
];
---

<BaseLayout title="MEDIA 정보" description="샘틀 미디어 - 유튜브 영상 및 뉴스 보도">

  <!-- 페이지 헤더 -->
  <section class="bg-navy py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-steel-light text-sm font-semibold uppercase tracking-widest mb-2">Media</p>
      <h1 class="text-white text-4xl font-bold">MEDIA 정보</h1>
    </div>
  </section>

  <!-- YouTube 섹션 -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <svg class="w-7 h-7 text-red-600" fill="currentColor" viewBox="0 0 24 24">
          <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        <h2 class="text-2xl font-bold text-navy">YouTube 영상</h2>
      </div>

      <!-- 메인 임베드 영상 -->
      <div class="bg-gray-50 rounded-xl overflow-hidden shadow-sm border border-gray-200 mb-6">
        <div class="relative w-full" style="padding-bottom: 56.25%;">
          <iframe
            class="absolute inset-0 w-full h-full rounded-t-xl"
            src={`https://www.youtube.com/embed/${firstVideoId}?list=${youtubePlaylistId}`}
            title="샘틀 유튜브 채널"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
        <div class="p-5 flex items-center justify-between">
          <p class="text-sm text-gray-600">샘틀 공식 YouTube 채널 - 제품 소개 및 현장 시연 영상</p>
          <a
            href={`https://www.youtube.com/playlist?list=${youtubePlaylistId}`}
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 ml-4 inline-flex items-center gap-2 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            전체 재생목록 보기
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 뉴스 섹션 -->
  <section class="py-16 bg-gray-50 border-t border-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <svg class="w-7 h-7 text-steel" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
        <h2 class="text-2xl font-bold text-navy">뉴스 보도</h2>
      </div>

      <div class="space-y-4">
        {newsItems.map((news) => (
          <a
            href={news.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group block bg-white rounded-lg border border-gray-200 shadow-sm hover:shadow-md hover:border-steel transition-all p-6"
          >
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                  <span class="bg-steel/10 text-steel text-xs font-semibold px-2.5 py-0.5 rounded">
                    {news.source}
                  </span>
                  <span class="text-gray-400 text-xs">{news.date}</span>
                </div>
                <h3 class="text-navy font-semibold group-hover:text-steel transition-colors mb-1">
                  {news.title}
                </h3>
                <p class="text-gray-500 text-sm leading-relaxed">{news.description}</p>
              </div>
              <svg class="w-5 h-5 text-gray-400 group-hover:text-steel shrink-0 mt-1 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
