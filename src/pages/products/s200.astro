---
import BaseLayout from '../../layouts/BaseLayout.astro';

const specs = [
  { label: '제품명', value: '수위조절기 S200 시리즈 (S201 / S202 / S203)' },
  { label: '측정 방식', value: '전기전도도 방식 (전극봉)' },
  { label: '제어 방식', value: '릴레이 출력 (ON/OFF 제어)' },
  { label: '전원', value: 'AC 220V / DC 12V (모델별 상이)' },
  { label: '보호 등급', value: 'IP65' },
  { label: '동작 온도', value: '-10°C ~ +60°C' },
  { label: '출력', value: '릴레이 1~3채널 (모델별 상이)' },
  { label: '하우징', value: 'ABS 수지 / 알루미늄 다이캐스팅' },
];

const features = [
  '전극봉 방식의 정밀 수위 감지로 오동작 최소화',
  '상·하한 수위 독립 설정으로 다양한 운용 조건 대응',
  'LED 상태 표시로 현장에서 즉시 동작 확인 가능',
  '소형·경량 설계로 기존 배선반 내 간편 설치',
  '태양광 DC 전원 운용 모델(S203) 포함',
  '국내 생산 및 A/S 지원',
];

const applications = [
  '논 물꼬 자동 수위 제어',
  '농업용 저수조·양수장 수위 관리',
  '공업용 냉각수·세척수 탱크 수위 제어',
  '소규모 상수도 배수지 수위 제어',
];
---

<BaseLayout title="수위조절기 S200 시리즈" description="샘틀 수위조절기 S200 시리즈 - 농업·산업 현장의 정밀 수위 자동 제어 장치.">

  <!-- 브레드크럼 + 페이지 헤더 -->
  <section class="bg-navy py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-gray-400 text-sm mb-4">
        <a href="/" class="hover:text-white transition-colors">홈</a>
        <span class="mx-2">/</span>
        <a href="/products" class="hover:text-white transition-colors">제품 소개</a>
        <span class="mx-2">/</span>
        <span class="text-gray-200">수위조절기 S200 시리즈</span>
      </nav>
      <p class="text-steel-light text-xs font-semibold uppercase tracking-widest mb-2">Water Level Controller</p>
      <h1 class="text-white text-4xl font-bold">수위조절기 S200 시리즈</h1>
    </div>
  </section>

  <!-- 제품 이미지 + 개요 -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-start">
        <!-- 이미지 -->
        <div class="bg-navy-light rounded-lg overflow-hidden flex items-center justify-center min-h-80">
          <img
            src="/brochures/product-s200.png"
            alt="수위조절기 S200 시리즈 제품 이미지"
            class="object-contain w-full"
          />
        </div>
        <!-- 개요 -->
        <div>
          <h2 class="text-navy text-2xl font-bold mb-4">제품 개요</h2>
          <p class="text-gray-600 leading-relaxed mb-6">
            S200 시리즈는 농업·산업 현장의 수위 자동 제어를 위한 장치입니다.
            전기전도도(전극봉) 방식으로 수위를 정밀 감지하고, 릴레이 출력으로 펌프·밸브를 직접 제어합니다.
            소형·경량 설계로 기존 배선반에 쉽게 통합할 수 있습니다.
          </p>

          <h3 class="text-navy font-bold text-base mb-3">주요 특징</h3>
          <ul class="space-y-2 mb-8">
            {features.map((f) => (
              <li class="flex items-start gap-3 text-gray-600 text-sm">
                <span class="mt-1 w-1.5 h-1.5 rounded-full bg-steel shrink-0"></span>
                {f}
              </li>
            ))}
          </ul>

          <!-- CTA -->
          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href="/brochures/brochure-s200.pdf"
              download
              class="flex-1 text-center px-6 py-3 bg-steel text-white font-semibold rounded hover:bg-steel-light transition-colors"
            >
              브로슈어 다운로드
            </a>

          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 사양 -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-navy text-2xl font-bold mb-8">제품 사양</h2>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse bg-white rounded-lg overflow-hidden shadow-sm border border-gray-200">
          <thead>
            <tr class="bg-navy">
              <th class="text-left text-white text-sm font-semibold px-6 py-3 w-1/3">항목</th>
              <th class="text-left text-white text-sm font-semibold px-6 py-3">사양</th>
            </tr>
          </thead>
          <tbody>
            {specs.map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="px-6 py-3 text-sm font-medium text-navy border-t border-gray-100">{row.label}</td>
                <td class="px-6 py-3 text-sm text-gray-600 border-t border-gray-100">{row.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-gray-400 mt-3">* 사양은 모델 및 옵션에 따라 변경될 수 있습니다.</p>
    </div>
  </section>

  <!-- 적용 분야 -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-navy text-2xl font-bold mb-8">적용 분야</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {applications.map((app) => (
          <div class="bg-gray-50 border border-gray-200 rounded-lg p-5 flex items-start gap-3">
            <span class="mt-1 w-2 h-2 rounded-full bg-steel shrink-0"></span>
            <p class="text-gray-700 text-sm">{app}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 다른 제품 보기 -->
  <section class="bg-gray-50 py-10 border-t border-gray-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-gray-600 text-sm">다른 제품도 확인해 보세요.</p>
      <a
        href="/products/reservoir"
        class="inline-flex items-center text-steel font-semibold text-sm hover:text-steel-light transition-colors"
      >
        저수지 수위측정장치 보기
        <svg class="ml-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>

</BaseLayout>
