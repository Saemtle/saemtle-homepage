---
const base = import.meta.env.BASE_URL;
const navLinks = [
  { label: '홈', href: base },
  { label: '제품 소개', href: `${base}products` },
  { label: '회사소개', href: `${base}company` },
  { label: 'MEDIA', href: `${base}media` },
];

const currentPath = Astro.url.pathname;
---

<header class="bg-navy sticky top-0 z-50 border-b border-navy-light shadow-lg">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- 로고 -->
      <a href={base} class="flex items-center gap-2 group">
        <span
          class="text-steel-light text-2xl font-bold tracking-widest group-hover:text-white transition-colors"
          style="font-variant: small-caps; letter-spacing: 0.15em;"
        >
          SAEMTLE
        </span>
        <span class="text-gray-400 text-sm font-light hidden sm:block">샘틀</span>
      </a>

      <!-- 데스크탑 네비게이션 -->
      <nav class="hidden md:flex items-center gap-1">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class={`px-4 py-2 text-sm font-medium rounded transition-colors ${
                currentPath === link.href
                  ? 'text-white bg-navy-light'
                  : 'text-gray-300 hover:text-white hover:bg-navy-light'
              }`}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <!-- 모바일 햄버거 (JS 없이 checkbox 트릭) -->
      <label for="mobile-menu-toggle" class="md:hidden cursor-pointer p-2 text-gray-300 hover:text-white">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </label>
    </div>
  </div>

  <!-- 모바일 메뉴 -->
  <input type="checkbox" id="mobile-menu-toggle" class="hidden peer" />
  <nav class="hidden peer-checked:block md:hidden bg-navy-dark border-t border-navy-light">
    <div class="max-w-6xl mx-auto px-4 py-3 flex flex-col gap-1">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="px-4 py-3 text-sm font-medium text-gray-300 hover:text-white hover:bg-navy-light rounded transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>
